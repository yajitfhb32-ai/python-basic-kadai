      "source": [
        "def add_two_arguments(price, tax):\n",
        "    # 与えられた引数priceと引数taxを加算し、変数totalに代入する\n",
        "    total = price + tax\n",
        "\n",
        "    # 変数totalの値を戻り値として返す\n",
        "    return total\n",
        "\n",
        "# 関数を呼び出し、引数として購入金額と消費税を渡す\n",
        "result = add_two_arguments(110, 10)\n",
        "print(f\"合計金額は{result}円です\")"
      ]
    }
