      "source": [
        "import random\n",
        "\n",
        "# 1から100までの範囲から正の整数をランダムに変数varに代入\n",
        "var = random.randint(1, 100)\n",
        "\n",
        "print(f\"選ばれた数値: {var}\")\n",
        "\n",
        "# 条件分岐\n",
        "if var % 3 == 0 and var % 5 == 0:\n",
        "    print(\"FizzBuzz\")\n",
        "elif var % 3 == 0:\n",
        "    print(\"Fizz\")\n",
        "elif var % 5 == 0:\n",
        "    print(\"Buzz\")\n",
        "else:\n",
        "    print(var)"
      ]
    }
  ]
}